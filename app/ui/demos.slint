// The live scenes of the welcome and privacy pages: drawn by the UI (sharp at any scale, light and dark, a few
// kilobytes), with fictional data, never the person's files. They run on `animation-tick()`, so only while their page
// is on screen, and not at all while paused under the pointer; without Windows' animation effects each stands still on
// its finished state.
//
// Slint's software renderer can't transform elements, so every scene takes a factor, `k`, and multiplies its positions,
// sizes and fonts by it: everything scales with the window, and text stays sharp.

import { Theme } from "theme.slint";
import { Glyph } from "widgets.slint";

export struct DemoRow {
    name: styled-text,
    detail: string,
    glyph: string,
}

global Motion {
    /// 0 before `start`, 1 after `end`, straight in between.
    public pure function line(t: float, start: float, end: float) -> float {
        max(0, min(1, (t - start) / (end - start)))
    }
    /// 0 before `start`, 1 after `end`, eased in between.
    public pure function ramp(t: float, start: float, end: float) -> float {
        let x = max(0, min(1, (t - start) / (end - start)));
        x * x * (3 - 2 * x)
    }
    /// In over `start`…`shown`, out over `hide`…`end`.
    public pure function span(t: float, start: float, shown: float, hide: float, end: float) -> float {
        Motion.ramp(t, start, shown) * (1 - Motion.ramp(t, hide, end))
    }
}

/// What the demos type, one letter more each.
global Typing {
    out property <[string]> wifi: ["w", "wi", "wif", "wifi", "wifi ", "wifi p", "wifi pa", "wifi pas", "wifi pass", "wifi passw", "wifi passwo", "wifi passwor", "wifi password"];
    out property <[string]> passport: ["p", "pa", "pas", "pass", "passp", "passpo", "passpor", "passport"];
    out property <[string]> recursion: ["t", "th", "the", "the ", "the p", "the pa", "the par", "the part", "the part ", "the part a", "the part ab", "the part abo", "the part abou", "the part about", "the part about ", "the part about r", "the part about re", "the part about rec", "the part about recu", "the part about recur", "the part about recurs", "the part about recursi", "the part about recursio", "the part about recursion"];
    out property <[string]> contract: ["m", "my", "my ", "my r", "my re", "my ren", "my rent", "my renta", "my rental", "my rental ", "my rental c", "my rental co", "my rental con", "my rental cont", "my rental contr", "my rental contra", "my rental contrac", "my rental contract"];
    out property <[string]> password: ["d", "de", "def", "defi", "defin", "defini", "definit", "definite", "definitel", "definitely", "definitely-", "definitely-n", "definitely-no", "definitely-not", "definitely-not-", "definitely-not-p", "definitely-not-pa", "definitely-not-pas", "definitely-not-pass", "definitely-not-passw", "definitely-not-passwo", "definitely-not-passwor", "definitely-not-password", "definitely-not-password1", "definitely-not-password12", "definitely-not-password123"];
    out property <string> secret: "definitely-not-password123";
}

/// A scene's clock: seconds since it started. It stops on the exact frame while `paused`, and carries on from there. Once
/// stopped nothing here reads the tick, so a scene that's all on this clock asks for no frames at all.
export component Clock {
    in property <bool> paused;
    // Not started yet: it stands on 0.
    in property <bool> running: true;
    property <duration> begun;
    property <duration> held;
    property <bool> started;
    property <bool> stopped;
    out property <float> seconds: !Theme.animate || !root.started ? 0 : root.stopped ? root.held / 1s : (animation-tick() - root.begun) / 1s;
    function start() {
        root.begun = animation-tick();
        root.held = 0ms;
        root.stopped = root.paused;
        root.started = true;
    }
    init => {
        if (root.running) { root.start(); }
    }
    changed running => {
        if (root.running && !root.started) { root.start(); }
    }
    changed paused => {
        if (root.started && root.paused) {
            root.held = animation-tick() - root.begun;
            root.stopped = true;
        } else if (root.started) {
            root.begun = animation-tick() - root.held;
            root.stopped = false;
        }
    }
}

/// One bottom corner of a scene's line: it follows the card's curve (12 px at k = 1), and it's either unlit or lit, with a
/// moment between. A fixed shape: drawn again only when its color changes.
component SceneCorner inherits Path {
    in property <float> lit;
    viewbox-width: 100;
    viewbox-height: 100;
    fill: transparent;
    stroke: Theme.accent.mix(Theme.stroke, root.lit);
}

/// How far a scene has come, in its card's bottom edge: the line curves up into both corners, in segments when the scene
/// has parts. Slint's software renderer can't clip to a rounded corner, so a straight line would poke past the curves.
///
/// Only the straight part follows the clock from frame to frame. The corners take their state through `changed`, not a
/// binding: anything bound to the clock counts as changed, and is drawn again, every frame.
export component SceneLine inherits Rectangle {
    in property <float> progress;
    in property <int> segments: 1;
    in property <float> k: 1;
    property <length> thick: 2.5px * root.k;
    property <length> radius: 12px * root.k;
    // Stays inside its box, as a `Path`'s stroke does: this makes the curve's outer edge the card's.
    property <length> corner-box: root.radius + root.thick / 2;
    property <length> arc: (root.radius - root.thick / 2) * 1.5708;
    property <length> straight: self.width - 2 * root.radius;
    property <length> gap: 3px * root.k;
    // Each segment is as long as the others, curves included.
    property <length> each: (root.straight + 2 * root.arc - (root.segments - 1) * root.gap) / root.segments;
    property <float> left-now: clamp(root.each * clamp(root.progress * root.segments, 0, 1) / root.arc, 0, 1);
    property <float> right-now: clamp((root.each * clamp(root.progress * root.segments - root.segments + 1, 0, 1) - root.each + root.arc) / root.arc, 0, 1);
    property <float> left-lit;
    property <float> right-lit;
    changed left-now => { root.left-lit = root.left-now; }
    changed right-now => { root.right-lit = root.right-now; }
    height: root.corner-box;
    SceneCorner {
        x: 0px;
        y: 0px;
        width: root.corner-box;
        height: root.corner-box;
        stroke-width: root.thick;
        commands: "M0 0A100 100 0 0 0 100 100";
        lit: root.left-lit;
    }
    SceneCorner {
        x: parent.width - self.width;
        y: 0px;
        width: root.corner-box;
        height: root.corner-box;
        stroke-width: root.thick;
        commands: "M100 0A100 100 0 0 1 0 100";
        lit: root.right-lit;
    }
    for index in root.segments: Rectangle {
        // Along the straight part: the first and last begin and end on the curves.
        property <length> from: index * (root.each + root.gap) - root.arc;
        property <length> start: max(self.from, 0px);
        x: root.radius + self.start;
        y: parent.height - root.thick;
        width: min(self.from + root.each, root.straight) - self.start;
        height: root.thick;
        background: Theme.stroke;
        Rectangle {
            x: 0px;
            width: clamp(parent.from + root.each * clamp(root.progress * root.segments - index, 0, 1) - parent.start, 0px, parent.width);
            background: Theme.accent;
        }
    }
}

/// What a scene says under the pointer, in its top-right corner: the two bars of paused reading, in a small round chip, or
/// words on a card still waiting ("Show now"). Fades in with the outline.
export component SceneBadge inherits Rectangle {
    in property <string> label;
    in property <bool> shown;
    in property <float> k: 1;
    height: (root.label == "" ? 18px : 20px) * root.k;
    width: root.label == "" ? self.height : badge-text.preferred-width + 16px * root.k;
    border-radius: self.height / 2;
    background: Theme.popover;
    border-width: 1px;
    border-color: Theme.accent;
    opacity: root.shown ? 1 : 0;
    animate opacity { duration: 120ms; }
    if root.label == "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 7.5px * root.k;
        height: 8.5px * root.k;
        Rectangle { x: 0px; width: 2.5px * root.k; border-radius: 1px; background: Theme.accent; }
        Rectangle { x: 5px * root.k; width: 2.5px * root.k; border-radius: 1px; background: Theme.accent; }
    }
    badge-text := Text { text: root.label; font-size: 10.5px * root.k; font-weight: 600; color: Theme.accent; }
}

/// The search box's caret.
component Caret inherits Rectangle {
    in property <float> t;
    in property <float> k: 1;
    width: 1.5px * root.k;
    background: Theme.accent;
    opacity: mod(self.t, 1) < 0.55 ? 1 : 0;
}

/// A query typing itself into a small field.
component QueryChip inherits Rectangle {
    in property <[string]> typing;
    in property <float> progress; // 0 to 1
    in property <float> t;
    in property <float> k: 1;
    in property <length> font-size: 11.5px * root.k;
    height: 22px * root.k;
    border-radius: 6px * root.k;
    background: Theme.field;
    border-width: 1px;
    border-color: Theme.stroke;
    clip: true;
    HorizontalLayout {
        padding-left: 7px * root.k;
        padding-right: 8px * root.k;
        spacing: 5px * root.k;
        Glyph {
            width: 11px * root.k;
            height: 11px * root.k;
            y: (parent.height - self.height) / 2;
            stroke-width: 2.2px * root.k;
            commands: "M11 4a7 7 0 1 0 0 14a7 7 0 1 0 0-14z M20 20l-4-4";
            stroke: Theme.text-2;
        }
        HorizontalLayout {
            spacing: 1px * root.k;
            alignment: start;
            Text {
                text: root.progress <= 0 ? "" : root.typing[min(root.typing.length - 1, floor(root.progress * root.typing.length))];
                font-size: root.font-size;
                color: Theme.text;
                vertical-alignment: center;
            }
            if root.progress < 1: Caret { t: root.t; k: root.k; height: 12px * root.k; y: (parent.height - self.height) / 2; }
        }
    }
}

/// A small lock chip: what was hidden.
component LockChip inherits Rectangle {
    in property <string> label;
    in property <float> k: 1;
    height: 20px * root.k;
    width: chip-row.preferred-width + 14px * root.k;
    border-radius: 10px * root.k;
    background: Theme.accent;
    chip-row := HorizontalLayout {
        x: 7px * root.k;
        width: self.preferred-width;
        spacing: 4px * root.k;
        Glyph {
            width: 11px * root.k;
            height: 11px * root.k;
            y: (parent.height - self.height) / 2;
            stroke-width: 2.4px * root.k;
            commands: "M6 11h12v9H6z M8.5 11V8a3.5 3.5 0 0 1 7 0v3";
            stroke: Theme.on-accent;
        }
        Text { text: root.label; font-size: 10px * root.k; font-weight: 600; color: Theme.on-accent; vertical-alignment: center; }
    }
}

/// A line of text breaking up into blocks: `broken` from 0 (the text) to 1 (blocks). `columns` of them cover the text.
component Pixelated inherits Rectangle {
    in property <string> label;
    in property <float> broken;
    in property <length> block: 5px;
    in property <length> font-size: 10.5px;
    in property <string> font-family: Theme.font;
    in property <int> font-weight: 400;
    in property <int> columns: 12;
    in property <int> rows: 2;
    in property <color> ink;
    clip: true;
    Text {
        x: 0px;
        y: 0px;
        height: parent.height;
        text: root.label;
        font-size: root.font-size;
        font-family: root.font-family;
        font-weight: root.font-weight;
        color: root.ink;
        vertical-alignment: center;
        opacity: 1 - root.broken;
    }
    for index in root.columns * root.rows: Rectangle {
        property <int> column: mod(index, root.columns);
        x: self.column * root.block;
        y: (parent.height - root.rows * root.block) / 2 + floor(index / root.columns) * root.block;
        width: root.block;
        height: root.block;
        background: root.ink;
        // They arrive left to right, not all at once, each its own shade.
        opacity: (0.3 + mod(index * 37, 100) / 100 * 0.56) * Motion.ramp(root.broken, self.column / (root.columns * 1.6), self.column / (root.columns * 1.6) + 0.34);
    }
}

/// The reading pass's outline around a line it read.
component Outline inherits Rectangle {
    in property <float> k: 1;
    border-width: 1px;
    border-radius: 2px * root.k;
    border-color: Theme.accent;
}

// ---- Searches instantly, as you type: the ranking itself (in Rust) over 10,000 made-up names. -----------------------

export component WelcomeSearch inherits VerticalLayout {
    in property <[DemoRow]> rows;
    in property <string> typed;
    in property <string> time;
    in property <float> k: 1;
    in property <float> t;
    spacing: 3px * root.k;
    Rectangle {
        height: 28px * root.k;
        border-radius: 7px * root.k;
        background: Theme.field;
        border-width: 1px;
        border-color: Theme.stroke;
        HorizontalLayout {
            padding-left: 9px * root.k;
            padding-right: 9px * root.k;
            spacing: 7px * root.k;
            Glyph {
                width: 13px * root.k;
                height: 13px * root.k;
                y: (parent.height - self.height) / 2;
                stroke-width: 2.1px * root.k;
                commands: "M11 4a7 7 0 1 0 0 14a7 7 0 1 0 0-14z M20 20l-4-4";
                stroke: Theme.text-2;
            }
            HorizontalLayout {
                spacing: 1px * root.k;
                alignment: start;
                horizontal-stretch: 1;
                Text { text: root.typed; font-family: Theme.display-font; font-size: 13px * root.k; color: Theme.text; vertical-alignment: center; }
                Caret { t: root.t * 1.6; k: root.k; height: 14px * root.k; y: (parent.height - self.height) / 2; }
            }
            Text { text: root.time; font-size: 10.5px * root.k; font-weight: 600; color: Theme.accent; vertical-alignment: center; horizontal-stretch: 0; }
        }
    }
    for row in root.rows: Rectangle {
        height: 23px * root.k;
        HorizontalLayout {
            padding-left: 9px * root.k;
            padding-right: 9px * root.k;
            spacing: 8px * root.k;
            Glyph {
                width: 13px * root.k;
                height: 13px * root.k;
                y: (parent.height - self.height) / 2;
                stroke-width: 1.9px * root.k;
                commands: row.glyph;
                stroke: Theme.clay;
            }
            Rectangle {
                horizontal-stretch: 1;
                clip: true;
                StyledText {
                    x: 0px;
                    width: 1000px * root.k;
                    height: parent.height;
                    text: row.name;
                    default-color: Theme.text;
                    default-font-size: 12px * root.k;
                    default-font-family: Theme.font;
                    vertical-alignment: center;
                    max-lines: 1;
                }
            }
            Text { text: row.detail; font-size: 10.5px * root.k; color: Theme.text-3; vertical-alignment: center; horizontal-stretch: 0; }
        }
    }
}

// ---- Searches inside files: six kinds of document, one word found in all. --------------------------------------------

struct Document {
    label: string,
    color: color,
    before: string,
    after: string,
    // Where the word sits among the page's lines.
    line: int,
    // What it is (0 a document, 1 an image, 2 a video, 3 a recording), and where the word was found, on its row ("In
    // video · 1:24"; none on the page as it was).
    kind: int,
    found: string,
}

component MiniDocument inherits Rectangle {
    in property <Document> document;
    in property <float> lit;     // the word on the page lighting up
    in property <float> folded;  // 0 a page, 1 a result row
    in property <float> k: 1;
    border-radius: (4px + (1 - self.folded) * 1px) * root.k;
    background: Theme.dark ? #ffffff14 : #ffffff;
    border-width: 1px;
    border-color: Theme.stroke;
    clip: true;
    // The format's band on a page, its chip on a row.
    Rectangle {
        x: root.folded * 4px * root.k;
        y: root.folded * ((parent.height - 14px * root.k) / 2);
        width: (1 - root.folded) * parent.width + root.folded * 30px * root.k;
        height: (12px + root.folded * 2px) * root.k;
        border-radius: root.folded * 3px * root.k;
        background: root.document.color;
        Text { text: root.document.label; font-size: 8.5px * root.k; font-weight: 700; color: #fffaf3; }
    }
    // The page's lines of text.
    if root.document.kind == 0: Rectangle {
    for line in 6: Rectangle {
        x: 6px * root.k;
        y: (17px + line * 9px) * root.k;
        width: (parent.width - 12px * root.k) * (mod(line * 3 + 4, 5) / 8 + 0.5);
        height: 4px * root.k;
        border-radius: 2px * root.k;
        opacity: 1 - root.folded * 3;
        background: line == root.document.line ? (root.lit > 0.5 ? Theme.accent : Theme.stroke-strong) : Theme.stroke-strong;
        drop-shadow-blur: line == root.document.line ? root.lit * 7px * root.k : 0px;
        drop-shadow-color: Theme.accent;
    }
    }
    // An image: a whiteboard photographed, its words in lines.
    if root.document.kind == 1: Rectangle {
        x: 4px * root.k;
        y: 15px * root.k;
        width: parent.width - 8px * root.k;
        height: parent.height - 19px * root.k;
        border-radius: 2px * root.k;
        background: @linear-gradient(160deg, #8a9bb0 0%, #b9a585 100%);
        opacity: 1 - root.folded * 3;
        clip: true;
        Rectangle {
            x: 6px * root.k;
            y: 6px * root.k;
            width: parent.width - 12px * root.k;
            height: parent.height - 14px * root.k;
            border-radius: 1.5px * root.k;
            background: #f3f1ec;
            drop-shadow-blur: 3px * root.k;
            drop-shadow-color: #00000040;
            for line in 3: Rectangle {
                x: 5px * root.k;
                y: (6px + line * 10px) * root.k;
                width: (parent.width - 10px * root.k) * (line == 0 ? 0.8 : line == 1 ? 0.55 : 0.68);
                height: 4px * root.k;
                border-radius: 2px * root.k;
                background: line == root.document.line ? (root.lit > 0.5 ? Theme.accent : #5b6b85) : #5b6b85;
                drop-shadow-blur: line == root.document.line ? root.lit * 7px * root.k : 0px;
                drop-shadow-color: Theme.accent;
            }
        }
    }
    // A video: a frame of a talk, its slide's words in lines, and where it is in the video.
    if root.document.kind == 2: Rectangle {
        x: 4px * root.k;
        y: 15px * root.k;
        width: parent.width - 8px * root.k;
        height: parent.height - 19px * root.k;
        border-radius: 2px * root.k;
        background: #1e2127;
        opacity: 1 - root.folded * 3;
        clip: true;
        Rectangle {
            x: 6px * root.k;
            y: 5px * root.k;
            width: parent.width - 12px * root.k;
            height: parent.height - 18px * root.k;
            background: #e9edf2;
            for line in 3: Rectangle {
                x: 5px * root.k;
                y: (5px + line * 9px) * root.k;
                width: (parent.width - 10px * root.k) * (line == 0 ? 0.62 : line == 1 ? 0.82 : 0.5);
                height: (line == 0 ? 5px : 3.5px) * root.k;
                border-radius: 2px * root.k;
                background: line == root.document.line ? (root.lit > 0.5 ? Theme.accent : #6d7684) : #6d7684;
                drop-shadow-blur: line == root.document.line ? root.lit * 7px * root.k : 0px;
                drop-shadow-color: Theme.accent;
            }
        }
        // The timeline, and the moment.
        Rectangle { x: 6px * root.k; y: parent.height - 7px * root.k; width: parent.width - 12px * root.k; height: 2px * root.k; background: #ffffff40; }
        Rectangle { x: 6px * root.k; y: parent.height - 7px * root.k; width: (parent.width - 12px * root.k) * 0.3; height: 2px * root.k; background: Theme.accent; }
        Rectangle { x: 6px * root.k + (parent.width - 12px * root.k) * 0.3 - 2.5px * root.k; y: parent.height - 8.5px * root.k; width: 5px * root.k; height: 5px * root.k; border-radius: 2.5px * root.k; background: Theme.accent; }
    }
    // A recording: its sound, the words said lighting up.
    if root.document.kind == 3: Rectangle {
        x: 4px * root.k;
        y: 15px * root.k;
        width: parent.width - 8px * root.k;
        height: parent.height - 19px * root.k;
        opacity: 1 - root.folded * 3;
        property <int> bars: 15;
        for bar in self.bars: Rectangle {
            property <float> tall: 0.18 + mod(bar * 47 + 13, 71) / 71 * 0.72;
            property <bool> said: bar >= 6 && bar <= 9;
            x: bar * (parent.width / parent.bars) + 1px * root.k;
            y: (parent.height - self.height) / 2;
            width: parent.width / parent.bars - 2px * root.k;
            height: (parent.height - 6px * root.k) * self.tall;
            border-radius: 1.5px * root.k;
            background: self.said && root.lit > 0.5 ? Theme.accent : Theme.stroke-strong;
            drop-shadow-blur: self.said ? root.lit * 6px * root.k : 0px;
            drop-shadow-color: Theme.accent;
        }
    }
    // On a row: the words around the match.
    found := Text {
        x: parent.width - self.width - 7px * root.k;
        height: parent.height;
        text: root.document.found;
        font-size: 9.5px * root.k;
        font-weight: 700;
        color: Theme.accent;
        vertical-alignment: center;
        opacity: root.folded * 2 - 1;
    }
    HorizontalLayout {
        x: 38px * root.k;
        width: parent.width - 42px * root.k - (root.document.found == "" ? 0px : found.width + 10px * root.k);
        opacity: root.folded * 2 - 1;
        alignment: start;
        Text { text: root.document.before; font-size: 10.5px * root.k; color: Theme.text-2; vertical-alignment: center; }
        Text { text: "budget"; font-size: 10.5px * root.k; font-weight: 700; color: Theme.accent; vertical-alignment: center; }
        Text { text: root.document.after; font-size: 10.5px * root.k; color: Theme.text-2; vertical-alignment: center; overflow: elide; }
    }
}

export component WelcomeInside inherits Rectangle {
    in property <float> k: 1;
    // Three documents, an image, a video and a recording.
    // From when it appeared, so a card arriving late starts at its beginning.
    in property <float> clock;
    property <float> t: Theme.animate ? mod(root.clock, 8.5) : 5.5;
    property <[Document]> everything: [
        { label: "PDF", color: #b9543f, before: "…the Q3 ", after: " review", line: 2, kind: 0, found: "In text" },
        { label: "XLSX", color: #5d8a4b, before: "Marketing ", after: " · 2026", line: 4, kind: 0, found: "In text" },
        { label: "EMAIL", color: #5b7c99, before: "Re: revised ", after: " for June", line: 3, kind: 0, found: "In text" },
        { label: "JPG", color: #4f8a8b, before: "Whiteboard: ", after: " 2027", line: 0, kind: 1, found: "In image" },
        { label: "MP4", color: #7a6a93, before: "Slide: ", after: " overview", line: 0, kind: 2, found: "In video · 1:24" },
        { label: "M4A", color: #a08a4a, before: "…so the ", after: " is final", line: 0, kind: 3, found: "Said · 3:05" },
    ];
    property <float> gap: Motion.ramp(root.t, 4.4, 5.1);
    opacity: 1 - Motion.ramp(root.t, 7.9, 8.4);

    QueryChip {
        x: 0px;
        y: 0px;
        k: root.k;
        width: 112px * root.k;
        t: root.t * 1.6;
        typing: ["b", "bu", "bud", "budg", "budge", "budget"];
        progress: Motion.ramp(root.t, 1.1, 2.3);
    }
    Text {
        x: 120px * root.k;
        y: 0px;
        height: 22px * root.k;
        text: "6 files, 6 formats";
        font-size: 10.5px * root.k;
        color: Theme.text-3;
        vertical-alignment: center;
        opacity: root.gap;
    }

    // The scan passing over the pages.
    property <float> scan: (root.t - 2.3) / 1.7;
    for document[index] in root.everything: MiniDocument {
        property <float> pop: Motion.ramp(root.t, index * 0.12, index * 0.12 + 0.35);
        property <length> page-x: index * (parent.width / 6);
        property <length> page-y: (28px + (mod(index, 2) == 0 ? 0px : 3px)) * root.k;
        property <length> page-width: parent.width / 6 - 8px * root.k;
        property <length> page-height: 70px * root.k;
        property <length> row-width: (parent.width - 8px * root.k) / 2;
        property <length> row-x: mod(index, 2) * (self.row-width + 8px * root.k);
        property <length> row-y: (27px + floor(index / 2) * 26px) * root.k;
        property <float> stagger: Motion.ramp(root.t, 4.4 + index * 0.05, 4.9 + index * 0.05);
        k: root.k;
        x: self.page-x + (self.row-x - self.page-x) * self.stagger;
        y: self.page-y + (self.row-y - self.page-y) * self.stagger + (1 - self.pop) * 8px * root.k;
        width: self.page-width + (self.row-width - self.page-width) * self.stagger;
        height: self.page-height + (23px * root.k - self.page-height) * self.stagger;
        opacity: self.pop;
        document: document;
        lit: Motion.ramp(root.scan * 6, index + 0.3, index + 0.9);
        folded: self.stagger;
    }
    Rectangle {
        x: root.scan * parent.width - self.width / 2;
        y: 22px * root.k;
        width: 26px * root.k;
        height: parent.height - 22px * root.k;
        visible: root.scan > 0 && root.scan < 1;
        background: @linear-gradient(90deg, #00000000 0%, Theme.accent-soft 50%, #00000000 100%);
    }
}

// ---- The images themselves. -------------------------------------------------------------------------------------------

/// A screenshot of Wi-Fi settings: fills its place.
component WifiImage inherits Rectangle {
    in property <float> k: 1;
    in property <float> reading;
    in property <float> broken;
    // A closer look at the password (the Privacy page): 0 its ordinary row, 1 larger, still beside its label, between its neighbors.
    in property <float> closer;
    // Its outline in the warm red.
    in property <bool> warns;
    property <length> lens-x: (10px - root.closer * 5px) * root.k;
    property <length> lens-y: (120px - root.closer * 5.5px) * root.k;
    property <length> lens-height: (19px + root.closer * 11px) * root.k;
    // A window of the theme's own: its colors follow the chosen theme's surfaces.
    property <color> surface: Theme.dark ? Theme.popover : #ffffff;
    property <color> ink: Theme.text;
    property <color> soft: Theme.text-2;
    background: self.surface;
    clip: true;
    // Its window's title bar.
    Rectangle {
        y: 0px;
        height: 22px * root.k;
        background: Theme.selected;
        Text { x: 10px * root.k; text: "Settings"; font-size: 9.5px * root.k; color: root.soft; vertical-alignment: center; height: parent.height; }
        for index in 3: Rectangle {
            x: parent.width - (14px + index * 14px) * root.k;
            y: 9px * root.k;
            width: 5px * root.k;
            height: 5px * root.k;
            border-radius: 2.5px * root.k;
            background: root.soft;
            opacity: 0.6;
        }
    }
    Text { x: 14px * root.k; y: 34px * root.k; text: "Wi-Fi"; font-size: 17px * root.k; font-weight: 700; font-family: Theme.display-font; color: root.ink; }
    Rectangle {
        x: parent.width - 58px * root.k;
        y: 39px * root.k;
        width: 44px * root.k;
        height: 15px * root.k;
        border-radius: 7.5px * root.k;
        background: #4f7a3a30;
        Text { text: "Connected"; font-size: 7px * root.k; font-weight: 600; color: Theme.ok; }
    }
    Rectangle { x: 14px * root.k; y: 64px * root.k; width: parent.width - 28px * root.k; height: 1px; background: Theme.divider; }
    Text { x: 14px * root.k; y: 74px * root.k; text: "Network"; font-size: 11px * root.k; color: root.soft; }
    Text { x: 86px * root.k; y: 74px * root.k; text: "Harbor-5G"; font-size: 11px * root.k; font-weight: 600; color: root.ink; }
    Text { x: 14px * root.k; y: 98px * root.k; text: "Security"; font-size: 11px * root.k; color: root.soft; }
    Text { x: 86px * root.k; y: 98px * root.k; text: "WPA3-Personal"; font-size: 11px * root.k; font-weight: 600; color: root.ink; }
    Text { x: 14px * root.k; y: 146px * root.k; text: "IP address"; font-size: 11px * root.k; color: root.soft; }
    Text { x: 86px * root.k; y: 146px * root.k; text: "192.168.1.24"; font-size: 11px * root.k; font-weight: 600; color: root.ink; }
    // The reading pass, line by line.
    for line[index] in [{ y: 32, at: 0 }, { y: 72, at: 1 }, { y: 96, at: 2 }, { y: 144, at: 4 }]: Outline {
        k: root.k;
        x: 10px * root.k;
        y: line.y * 1px * root.k;
        width: parent.width - 20px * root.k;
        height: (index == 0 ? 26px : 19px) * root.k;
        opacity: Motion.span(root.reading, line.at / 7, line.at / 7 + 0.1, 0.8, 1);
    }
    // The password's row: on top, for the closer look.
    Rectangle {
        x: root.lens-x;
        y: root.lens-y;
        width: parent.width - 2 * root.lens-x;
        height: root.lens-height;
        border-radius: 3px * root.k;
        background: root.surface.mix(Theme.bad, 0.84);
        visible: root.closer > 0;
        drop-shadow-blur: root.closer * 14px * root.k;
        drop-shadow-offset-y: root.closer * 2px * root.k;
        drop-shadow-color: #00000050;
    }
    Text { x: (14px - root.closer * 3px) * root.k; y: 122px * root.k; text: "Password"; font-size: (11px + root.closer * 0.5px) * root.k; color: root.soft; }
    Pixelated {
        x: (86px - root.closer * 19px) * root.k;
        y: (120px - root.closer * 3px) * root.k;
        width: parent.width - (96px - root.closer * 18px) * root.k;
        height: (19px + root.closer * 6px) * root.k;
        label: Typing.secret;
        font-size: (11px + root.closer * 4.4px) * root.k;
        font-weight: 600;
        block: (5.5px + root.closer * 2.2px) * root.k;
        columns: 28;
        broken: root.broken;
        ink: root.ink;
    }
    Outline {
        k: root.k;
        x: root.lens-x;
        y: root.lens-y;
        width: parent.width - 2 * self.x;
        height: root.lens-height;
        border-width: root.warns ? 2px : 1px;
        border-color: root.warns ? Theme.bad : Theme.accent;
        opacity: Motion.span(root.reading, 3 / 7, 3 / 7 + 0.1, 0.8, 1);
    }
}

/// A toy passport's page, in the German one's colors: the sample name, and nothing of anyone's.
component PassportImage inherits Rectangle {
    in property <float> k: 1;
    in property <float> reading;
    in property <float> broken;
    property <color> burgundy: #6e1a2a;
    property <color> ink: #2c2226;
    property <color> label: #7d5a63;
    property <length> page-width: min(self.width - 12px * self.k, 256px * self.k);
    property <length> page-height: 180px * self.k;
    background: Theme.dark ? #39332d : #d8cfc4;
    clip: true;
    Rectangle {
        x: (parent.width - root.page-width) / 2;
        y: (parent.height - root.page-height) / 2;
        width: root.page-width;
        height: root.page-height;
        border-radius: 5px * root.k;
        background: @linear-gradient(120deg, #f6e8e4 0%, #ebe0ea 100%);
        clip: true;
        // The fine lines of its security print.
        for ring in 5: Rectangle {
            x: parent.width * 0.62 - self.width / 2;
            y: parent.height * 0.55 - self.height / 2;
            width: (46px + ring * 24px) * root.k;
            height: (30px + ring * 16px) * root.k;
            border-radius: self.height / 2;
            border-width: 1px;
            border-color: #6e1a2a14;
        }
        Rectangle {
            y: 0px;
            height: 19px * root.k;
            background: root.burgundy;
            Text { x: 9px * root.k; height: parent.height; vertical-alignment: center; text: "BUNDESREPUBLIK DEUTSCHLAND"; font-size: 7.5px * root.k; font-weight: 700; color: #f0d9a8; }
            Text { x: parent.width - self.width - 9px * root.k; height: parent.height; vertical-alignment: center; text: "FEDERAL REPUBLIC OF GERMANY"; font-size: 6px * root.k; color: #f0d9a8; opacity: 0.85; }
        }
        Text { x: 9px * root.k; y: 22px * root.k; text: "REISEPASS / PASSPORT"; font-size: 8px * root.k; font-weight: 700; color: root.burgundy; }
        Text { x: parent.width - 86px * root.k; y: 21px * root.k; text: "Pass-Nr. / Passport No."; font-size: 5.5px * root.k; color: root.label; }
        Pixelated {
            x: parent.width - 86px * root.k;
            y: 28px * root.k;
            width: 78px * root.k;
            height: 13px * root.k;
            label: "C01X00T47";
            font-size: 9.5px * root.k;
            font-weight: 700;
            font-family: Theme.mono-font;
            block: 4.8px * root.k;
            columns: 11;
            broken: root.broken;
            ink: root.ink;
        }
        // The photo: only a silhouette.
        Rectangle {
            x: 9px * root.k;
            y: 37px * root.k;
            width: 54px * root.k;
            height: 70px * root.k;
            border-radius: 2px * root.k;
            background: #c9bcc0;
            clip: true;
            Rectangle { x: 16px * root.k; y: 14px * root.k; width: 22px * root.k; height: 26px * root.k; border-radius: 11px * root.k; background: #8d7f85; }
            Rectangle { x: 6px * root.k; y: 44px * root.k; width: 42px * root.k; height: 40px * root.k; border-radius: 16px * root.k; background: #8d7f85; }
        }
        for field[index] in [
            { label: "Name / Surname", value: "MUSTERMANN" },
            { label: "Vornamen / Given names", value: "ERIKA" },
            { label: "Staatsangehörigkeit / Nationality", value: "DEUTSCH" },
            { label: "Geburtstag / Date of birth", value: "12.08.1964" },
        ]: Rectangle {
            x: 70px * root.k;
            y: (42px + index * 17.5px) * root.k;
            width: parent.width - 76px * root.k;
            height: 17px * root.k;
            Text { x: 0px; y: 0px; text: field.label; font-size: 5.5px * root.k; color: root.label; }
            Text { x: 0px; y: 6px * root.k; text: field.value; font-size: 8.5px * root.k; font-weight: 700; color: root.ink; }
        }
        // The machine-readable lines.
        for line[index] in ["P<D<<MUSTERMANN<<ERIKA<<<<<<<<<<<<<<<<<<<<<<", "C01X00T478D<<6408125F3102282<<<<<<<<<<<<<<<6"]: Pixelated {
            x: 9px * root.k;
            y: (135px + index * 18px) * root.k;
            width: parent.width - 14px * root.k;
            height: 15px * root.k;
            label: line;
            font-size: 8.8px * root.k;
            font-family: Theme.mono-font;
            block: 4.9px * root.k;
            columns: 48;
            broken: root.broken;
            ink: root.ink;
        }
        // The reading pass.
        for line[index] in [
            { x: 7, y: 21, w: 100, h: 13 }, { x: 68, y: 41, w: 150, h: 17 }, { x: 68, y: 59, w: 150, h: 17 },
            { x: 68, y: 76, w: 150, h: 17 }, { x: 68, y: 94, w: 150, h: 17 }, { x: 7, y: 134, w: 240, h: 17 }, { x: 7, y: 152, w: 240, h: 17 },
        ]: Outline {
            k: root.k;
            x: line.x * 1px * root.k;
            y: line.y * 1px * root.k;
            width: line.w * 1px * root.k;
            height: line.h * 1px * root.k;
            opacity: Motion.span(root.reading, index / 9, index / 9 + 0.1, 0.8, 1);
        }
    }
}

/// A frame of a recorded lecture: its slide on recursion, and where it is in the video.
component LectureImage inherits Rectangle {
    in property <float> k: 1;
    in property <float> reading;
    property <color> ink: #1f2a37;
    background: #16181d;
    clip: true;
    // The slide.
    Rectangle {
        x: 12px * root.k;
        y: 10px * root.k;
        width: parent.width - 24px * root.k;
        height: parent.height - 44px * root.k;
        border-radius: 2px * root.k;
        background: #f2f4f7;
        Text { x: 14px * root.k; y: 10px * root.k; text: "Recursion"; font-size: 17px * root.k; font-weight: 700; font-family: Theme.display-font; color: root.ink; }
        Text { x: 14px * root.k; y: 36px * root.k; text: "A function that calls itself"; font-size: 10px * root.k; color: root.ink; opacity: 0.8; }
        Rectangle {
            x: 14px * root.k;
            y: 56px * root.k;
            width: 166px * root.k;
            height: 44px * root.k;
            border-radius: 3px * root.k;
            background: #e1e6ee;
            Text { x: 8px * root.k; y: 6px * root.k; text: "def fact(n):"; font-size: 9.5px * root.k; font-family: Theme.mono-font; color: root.ink; }
            Text { x: 8px * root.k; y: 18px * root.k; text: "    if n == 0: return 1"; font-size: 9.5px * root.k; font-family: Theme.mono-font; color: root.ink; }
            Text { x: 8px * root.k; y: 30px * root.k; text: "    return n * fact(n - 1)"; font-size: 9.5px * root.k; font-family: Theme.mono-font; color: root.ink; }
        }
        // The calls, one inside the next.
        for box in 4: Rectangle {
            x: max(192px * root.k, parent.width - 86px * root.k) + box * 8px * root.k;
            y: (54px + box * 7px) * root.k;
            width: (70px - box * 16px) * root.k;
            height: (50px - box * 14px) * root.k;
            border-radius: 3px * root.k;
            border-width: 1px;
            border-color: #7a6a93;
            background: #7a6a9314;
        }
        // The reading pass.
        for line[index] in [{ x: 10, y: 8, w: 104, h: 26 }, { x: 10, y: 34, w: 160, h: 16 }, { x: 10, y: 54, w: 174, h: 48 }]: Outline {
            k: root.k;
            x: line.x * 1px * root.k;
            y: line.y * 1px * root.k;
            width: line.w * 1px * root.k;
            height: line.h * 1px * root.k;
            opacity: Motion.span(root.reading, index / 5, index / 5 + 0.1, 0.8, 1);
        }
    }
    // The player: the moment it opens at, of the whole lecture.
    Rectangle {
        x: 12px * root.k;
        y: parent.height - 22px * root.k;
        width: parent.width - 24px * root.k;
        height: 14px * root.k;
        Path {
            x: 0px;
            y: 1px * root.k;
            width: 10px * root.k;
            height: 12px * root.k;
            viewbox-width: 10;
            viewbox-height: 12;
            commands: "M0 0L10 6L0 12z";
            fill: #ffffff;
        }
        Rectangle {
            x: 18px * root.k;
            y: (parent.height - self.height) / 2;
            width: parent.width - 96px * root.k;
            height: 3px * root.k;
            border-radius: 1.5px * root.k;
            background: #ffffff38;
            Rectangle { x: 0px; width: parent.width * 0.263; border-radius: 1.5px * root.k; background: Theme.accent; }
            Rectangle {
                x: parent.width * 0.263 - self.width / 2;
                y: (parent.height - self.height) / 2;
                width: 9px * root.k;
                height: 9px * root.k;
                border-radius: 4.5px * root.k;
                background: Theme.accent;
            }
        }
        Text { x: parent.width - self.width; height: parent.height; vertical-alignment: center; text: "12:40 / 48:10"; font-size: 9px * root.k; color: #ffffffcc; }
    }
}

/// A lease's first page: what it is about, not its name, finds it.
component ContractImage inherits Rectangle {
    in property <float> k: 1;
    in property <float> reading;
    property <color> ink: #2b2a28;
    property <length> page-width: min(self.width - 40px * self.k, 250px * self.k);
    background: Theme.dark ? #3a3631 : #d9d4cc;
    clip: true;
    Rectangle {
        x: (parent.width - root.page-width) / 2;
        y: 10px * root.k;
        width: root.page-width;
        height: parent.height;
        background: #fbfaf7;
        drop-shadow-blur: 8px * root.k;
        drop-shadow-color: #00000040;
        Text { x: 0px; width: parent.width; y: 12px * root.k; text: "RESIDENTIAL LEASE AGREEMENT"; font-size: 10px * root.k; font-weight: 700; color: root.ink; horizontal-alignment: center; }
        Text { x: 16px * root.k; y: 34px * root.k; text: "Between the landlord and the tenant named below,"; font-size: 7.5px * root.k; color: root.ink; opacity: 0.8; }
        Text { x: 16px * root.k; y: 44px * root.k; text: "for the flat at 12 Harbor Street, Apartment 4B."; font-size: 7.5px * root.k; color: root.ink; opacity: 0.8; }
        for clause[index] in [
            { title: "1. Term", text: "Twelve months, from 1 March 2026." },
            { title: "2. Rent", text: "1,450 a month, due on the first." },
            { title: "3. Deposit", text: "Two months' rent, held until the end." },
        ]: Rectangle {
            x: 16px * root.k;
            y: (62px + index * 24px) * root.k;
            width: parent.width - 32px * root.k;
            height: 22px * root.k;
            Text { x: 0px; y: 0px; text: clause.title; font-size: 8px * root.k; font-weight: 700; color: root.ink; }
            Text { x: 0px; y: 10px * root.k; text: clause.text; font-size: 7.5px * root.k; color: root.ink; opacity: 0.8; }
        }
        // The lines that sign it.
        for side in 2: Rectangle {
            x: (16px + side * 116px) * root.k;
            y: 146px * root.k;
            width: 100px * root.k;
            height: 1px;
            background: #2b2a2870;
        }
        // What it means, read as a whole.
        for line[index] in [{ y: 8, h: 20 }, { y: 31, h: 25 }, { y: 59, h: 74 }]: Outline {
            k: root.k;
            x: 10px * root.k;
            y: line.y * 1px * root.k;
            width: parent.width - 20px * root.k;
            height: line.h * 1px * root.k;
            opacity: Motion.span(root.reading, index / 5, index / 5 + 0.1, 0.8, 1);
        }
    }
}

// ---- Even searches what's in your images: a query, the image it found, what's in it broken up. -------------------------

export component WelcomeImages inherits Rectangle {
    in property <float> k: 1;
    in property <float> time;
    // Wi-Fi, a lecture, the passport, a lease.
    property <float> clock: Theme.animate ? root.time : 4.5;
    /// Which example, and how far along it is (each takes `spell` seconds).
    property <float> spell: 7;
    property <int> turn: mod(floor(root.clock / root.spell), 4);
    // 0 Wi-Fi, 2 the passport, 3 the lecture, 4 the lease (1 is no longer shown).
    property <int> example: [0, 3, 2, 4][root.turn];
    // What it found doesn't break up (nothing secret in it): the lecture opens at its moment, the lease is found by
    // what it means.
    property <bool> secret: root.example <= 2;
    property <float> t: mod(root.clock, root.spell);
    property <float> leaving: 1 - Motion.ramp(root.t, 6.35, 6.85);
    property <float> found: Motion.ramp(root.t, 1.45, 1.85);
    property <float> reading: (root.t - 1.75) / 1;
    property <float> broken: Motion.ramp(root.t, 2.75, 3.45);
    property <length> column: 170px * root.k;

    QueryChip {
        x: 0px;
        y: 0px;
        k: root.k;
        width: root.column;
        height: 27px * root.k;
        font-size: 12.5px * root.k;
        t: root.t * 1.6;
        opacity: root.leaving;
        typing: root.example == 0 ? Typing.wifi : root.example == 2 ? Typing.passport : root.example == 3 ? Typing.recursion : Typing.contract;
        progress: Motion.ramp(root.t, 0.2, 1.3);
    }
    Rectangle {
        x: 0px;
        y: (34px + (1 - root.found) * 6px) * root.k;
        width: root.column;
        height: 46px * root.k;
        border-radius: 7px * root.k;
        background: Theme.selected;
        opacity: root.found * root.leaving;
        VerticalLayout {
            padding-left: 10px * root.k;
            padding-right: 8px * root.k;
            alignment: center;
            spacing: 2px * root.k;
            Text {
                text: root.example == 0 ? "Screenshot 2026-03-14.png" : root.example == 2 ? "IMG_1204.jpg" : root.example == 3 ? "lecture 7.mp4" : "lease agreement.pdf";
                font-size: 12px * root.k;
                color: Theme.text;
                overflow: elide;
            }
            Text { text: root.example == 3 ? "In video · at 12:40" : root.example == 4 ? "By meaning" : "In image"; font-size: 10px * root.k; font-weight: 700; color: Theme.accent; }
        }
    }
    LockChip {
        x: 0px;
        y: 90px * root.k;
        k: root.k;
        label: root.example == 0 ? "Password hidden" : "Passport number hidden";
        opacity: Motion.ramp(root.t, 3.3, 3.7) * root.leaving;
        visible: root.secret;
    }
    Text {
        x: 0px;
        y: 88px * root.k;
        width: root.column;
        visible: !root.secret;
        text: root.example == 3 ? "Opens at the moment it's about." : "Not a word of it in its name.";
        font-size: 11px * root.k;
        color: Theme.text-2;
        wrap: word-wrap;
        opacity: Motion.ramp(root.t, 2.9, 3.3) * root.leaving;
    }

    // The image, large.
    Rectangle {
        x: root.column + 14px * root.k;
        y: (1 - root.found) * 8px * root.k;
        width: parent.width - self.x;
        height: parent.height;
        border-radius: 8px * root.k;
        border-width: 1px;
        border-color: Theme.stroke;
        clip: true;
        opacity: root.found * root.leaving;
        if root.example == 0: WifiImage { k: root.k; reading: root.reading; broken: root.broken; }
        if root.example == 2: PassportImage { k: root.k; reading: root.reading; broken: root.broken; }
        if root.example == 3: LectureImage { k: root.k; reading: root.reading; }
        if root.example == 4: ContractImage { k: root.k; reading: root.reading; }
    }
}

// ---- Privacy: the image is found by what's around the password; the password itself finds nothing. ----------------------

export component PrivacyDemo inherits Rectangle {
    in property <float> k: 1;
    // Freezes under the pointer (a tap toggles it on a touch screen), to take it in.
    property <bool> pinned;
    property <bool> paused: Theme.animate && (touch.has-hover || root.pinned);
    clock := Clock { paused: root.paused; }
    property <float> span: 21.5;
    property <float> t: Theme.animate ? mod(clock.seconds, root.span) : 9;
    // The first search: found. It reads the screenshot, good, good, good, huh, password? A closer look, and no.
    property <float> first: Motion.span(root.t, 1.4, 1.75, 11.9, 12.3);
    property <float> reading: Motion.line(root.t, 1.5, 3.5) * 0.386 + Motion.line(root.t, 3.5, 3.75) * 0.143 + Motion.line(root.t, 6.5, 7.3) * 0.171 + Motion.line(root.t, 7.6, 8.4) * 0.3;
    property <float> closer: Motion.span(root.t, 3.5, 3.95, 6.5, 7.3);
    property <float> broken: Motion.ramp(root.t, 6.5, 7.3);
    // The second: the password itself, and nothing.
    property <float> second: Motion.span(root.t, 15, 15.35, 20.5, 21);
    property <bool> asks-password: root.t >= 12.3;
    border-radius: 12px * root.k;
    background: Theme.raised;
    border-width: 1px;
    border-color: root.paused ? Theme.accent : Theme.divider;
    animate border-color { duration: Theme.animate ? 120ms : 0ms; }
    clip: true;
    property <length> pad: 14px * root.k;
    property <length> column: 286px * root.k;

    QueryChip {
        x: root.pad;
        y: root.pad;
        k: root.k;
        width: root.column;
        height: 30px * root.k;
        font-size: 13px * root.k;
        t: root.t * 1.6;
        typing: root.asks-password ? Typing.password : Typing.wifi;
        progress: root.asks-password ? Motion.line(root.t, 12.3, 15) : Motion.line(root.t, 0.1, 1.5);
        opacity: 1 - Motion.ramp(root.t, 20.5, 21);
    }
    // Found.
    Rectangle {
        x: root.pad;
        y: root.pad + 38px * root.k;
        width: root.column;
        height: 56px * root.k;
        border-radius: 8px * root.k;
        background: Theme.selected;
        opacity: root.first;
        HorizontalLayout {
            padding-left: 10px * root.k;
            padding-right: 10px * root.k;
            spacing: 10px * root.k;
            Glyph {
                width: 22px * root.k;
                height: 22px * root.k;
                y: (parent.height - self.height) / 2;
                stroke-width: 1.7px * root.k;
                commands: "M4 5h16v14H4z M4 15l5-5l4 4l3-3l4 4";
                stroke: Theme.clay;
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px * root.k;
                Text { text: "Screenshot 2026-03-14.png"; font-size: 13px * root.k; color: Theme.text; overflow: elide; }
                Text { text: "In image"; font-size: 10.5px * root.k; font-weight: 700; color: Theme.accent; }
            }
        }
    }
    LockChip {
        x: root.pad;
        y: root.pad + 102px * root.k;
        k: root.k * 1.12;
        label: "Password hidden";
        opacity: Motion.ramp(root.t, 6.9, 7.3) * root.first;
    }
    // Nothing found.
    VerticalLayout {
        x: root.pad;
        y: root.pad + 38px * root.k;
        width: root.column;
        spacing: 3px * root.k;
        opacity: root.second;
        Text { text: "Nothing found"; font-size: 15px * root.k; font-weight: 600; color: Theme.text; }
    }
    // What it means, under the search.
    Text {
        x: root.pad;
        y: parent.height - root.pad - 58px * root.k;
        width: root.column;
        height: 58px * root.k;
        vertical-alignment: bottom;
        wrap: word-wrap;
        text: "You can still find that one screenshot with your Wi-Fi password.";
        font-size: 13.5px * root.k;
        color: Theme.text-2;
        opacity: Motion.ramp(root.t, 7, 7.3) * root.first;
    }
    Text {
        x: root.pad;
        y: parent.height - root.pad - 58px * root.k;
        width: root.column;
        height: 58px * root.k;
        vertical-alignment: bottom;
        wrap: word-wrap;
        text: "But we do our best never to index the password itself.";
        font-size: 13.5px * root.k;
        color: Theme.text-2;
        opacity: root.second;
    }
    // The screenshot, large.
    Rectangle {
        x: root.pad + root.column + 16px * root.k;
        y: root.pad + (1 - root.first) * 8px * root.k;
        width: parent.width - self.x - root.pad;
        height: parent.height - 2 * root.pad;
        border-radius: 8px * root.k;
        border-width: 1px;
        border-color: Theme.stroke;
        clip: true;
        opacity: root.first;
        WifiImage { k: root.k * 1.12; reading: root.reading; broken: root.broken; closer: root.closer; warns: true; }
    }
    // Where the image was: what was never stored.
    Rectangle {
        x: root.pad + root.column + 16px * root.k;
        y: root.pad;
        width: parent.width - self.x - root.pad;
        height: parent.height - 2 * root.pad;
        border-radius: 8px * root.k;
        background: Theme.accent-soft;
        opacity: root.second;
        VerticalLayout {
            alignment: center;
            spacing: 10px * root.k;
            HorizontalLayout {
                alignment: center;
                Glyph {
                    width: 44px * root.k;
                    height: 44px * root.k;
                    stroke-width: 1.5px * root.k;
                    commands: "M6 11h12v9H6z M8.5 11V8a3.5 3.5 0 0 1 7 0v3";
                    stroke: Theme.accent;
                }
            }
            Text { text: "Not in the index"; font-size: 14px * root.k; font-weight: 600; color: Theme.text; horizontal-alignment: center; }
        }
    }
    SceneBadge {
        x: parent.width - self.width - 5px * root.k;
        y: 5px * root.k;
        k: root.k;
        shown: root.paused;
    }
    touch := TouchArea {
        clicked => {
            if (Theme.touch) { root.pinned = !root.pinned; }
        }
    }
}
