#include <winver.h>
1 ICON "../brand/excavate.ico"
1 24 "indexer.manifest"
// VERSION_NUMBERS and VERSION_TEXT: the version in Cargo.toml, passed by build.rs.
VS_VERSION_INFO VERSIONINFO
FILEVERSION VERSION_NUMBERS
PRODUCTVERSION VERSION_NUMBERS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Excavate"
      VALUE "FileDescription", "Excavate Reader"
      VALUE "FileVersion", VERSION_TEXT
      VALUE "InternalName", "excavate-indexer"
      VALUE "OriginalFilename", "excavate-indexer.exe"
      VALUE "ProductName", "Excavate"
      VALUE "ProductVersion", VERSION_TEXT
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
